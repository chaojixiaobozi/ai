        },
        "sort" : [
          1756084552485
        ]
      },
      {
        "_index" : "article",
        "_type" : "_doc",
        "_id" : "68abb6463a0dcb7feb8e2825",
        "_score" : null,
        "_source" : {
          "issueTime" : 1756083782568,
          "openCommentState" : "PUBLIC",
          "createTime" : 1756083782568,
          "readPermission" : "PUBLIC",
          "contentText" : "Ever wondered about fantasy football? It's like being the general manager of your own team, but with real-life players! You draft actual football players onto your fantasy squad, and they earn points for you based on their performance in real games – think touchdowns, yards, and tackles. You then compete against other managers in your league, trying to outscore them each week. To get started, you can usually join a league through popular sports websites like ESPN or Yahoo Sports. Once you're in, you'll participate in a draft to pick your players, and then the real fun begins!",
          "likeCount" : 0,
          "id" : "68abb6463a0dcb7feb8e2825",
          "title" : null,
          "userId" : 99678001,
          "matchId" : null,
          "commentCount" : 1
        },
        "sort" : [
          1756083782568
        ]
      },
      {
        "_index" : "article",
