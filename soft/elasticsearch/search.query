        "_id" : "68ab9be53a0dcb7feb8e161e",
        "_score" : null,
        "_source" : {
          "issueTime" : 1756077029707,
          "openCommentState" : "PUBLIC",
          "createTime" : 1756077029707,
          "readPermission" : "PUBLIC",
          "contentText" : "¡Golazo en LaLiga SmartBank! En la jornada 2, el Real Sociedad B venció al Málaga gracias a una espectacular chilena de Rafa Rodríguez en el minuto 86. Un tanto para enmarcar. Vídeo compartido por la Peña Malaguista Benamiel.",
          "likeCount" : 0,
          "id" : "68ab9be53a0dcb7feb8e161e",
