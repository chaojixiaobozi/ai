          "openCommentState" : "PUBLIC",
          "createTime" : 1756070763885,
          "readPermission" : "PUBLIC",
          "contentText" : "Rodrygo? Any fresh whispers about a massive PSG bid for him and Real Madrid? Earlier in the transfer window, there were some reports circulating. Could that be why things feel a bit quiet on our end now?",
          "likeCount" : 0,
          "id" : "68ab836b3a0dcb7feb8e1184",
