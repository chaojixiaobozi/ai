        "_score" : null,
        "_source" : {
          "issueTime" : 1756076689845,
          "openCommentState" : "PUBLIC",
          "createTime" : 1756076689845,
          "readPermission" : "PUBLIC",
          "contentText" : "Real Madrid secured a dramatic late win against Real Oviedo, with Vinícius Júnior netting the decisive goal in the 90+2nd minute to make it 1-0.",
          "likeCount" : 0,
          "id" : "68ab9a913a0dcb7feb8e15f9",
